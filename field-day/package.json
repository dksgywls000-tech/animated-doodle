{
  "name": "autumn-field-day",
  "version": "1.0.0",
  "description": "2026 하이테크본부 가을운동회 모바일 웹앱",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "cli": "tsx --env-file-if-exists=.env server/cli.ts",
    "hash-password": "tsx server/cli.ts hash-password",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "python3 scripts/prepare_assets.py",
    "build:demo": "node scripts/build-demo.mjs && cp dist/field-day-demo.html preview/field-day-demo.html",
    "build:netlify": "vite build --config vite.netlify.config.ts && node scripts/netlify-finish.mjs dist/netlify",
    "dev:firebase": "vite --config vite.netlify.config.ts",
    "firebase:build": "npm --prefix firebase/functions ci && npm --prefix firebase/functions run build",
    "test:firebase": "node scripts/firebase-test.mjs",
    "package:netlify": "npm run build:netlify && cd dist && rm -f netlify-upload.zip && zip -qr netlify-upload.zip netlify",
    "build:free": "vite build --config vite.free.config.ts && node scripts/netlify-finish.mjs dist/netlify-free",
    "package:free": "npm run build:free && cd dist && rm -rf netlify && cp -r netlify-free netlify && rm -f netlify-upload-free.zip && zip -qr netlify-upload-free.zip netlify && rm -rf netlify",
    "test:free": "bash scripts/free-test.sh"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "firebase": "^13.0.0",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}