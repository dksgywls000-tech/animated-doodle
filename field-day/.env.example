# ── 필수 ─────────────────────────────────────────
# PostgreSQL 접속 문자열
DATABASE_URL=postgres://fieldday:CHANGE_ME@localhost:5432/fieldday
# production(실제 운영) | demo(가상 TEST 명단, seed-demo 허용)
APP_MODE=production
# 로그인 시도 제한 키 HMAC용 비밀값 (16자 이상 임의 문자열, production 필수)
RATE_LIMIT_SECRET=

# ── 선택 ─────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
EVENT_ID=autumn-2026
# 점수 취소 비밀번호 해시. 비우면 기본값 1234 사용. `npm run hash-password`로 생성
SCORE_CANCEL_PASSWORD_HASH=
# HTTPS 뒤에서 운영하면 true (production 기본 true)
COOKIE_SECURE=
# 리버스 프록시(로드밸런서) 뒤라면 true — 실제 클라이언트 IP로 로그인 시도 제한
TRUST_PROXY=false
# 앱 주소와 다른 Origin을 허용해야 할 때만 (쉼표 구분)
ALLOWED_ORIGINS=
SESSION_TTL_HOURS=36
# 서버 시작 시 owner로 지정할 사번(쉼표 구분, 명단에 있어야 함)
BOOTSTRAP_OWNER_EMPLOYEE_IDS=
